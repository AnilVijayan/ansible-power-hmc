default-lease-time 600;
max-lease-time 7200;
authoritative;

{% if hostvars[groups['pxe'][0]].ansible_default_ipv4 is defined and hostvars[groups['pxe'][0]].ansible_default_ipv4.network is defined and hostvars[groups['pxe'][0]].ansible_default_ipv4.network != pmc_pao_install_host_subnet %}
# Local subnet declaration to allow dhcpd to bind on the PXE server's local interface
subnet {{ hostvars[groups['pxe'][0]].ansible_default_ipv4.network }} netmask {{ hostvars[groups['pxe'][0]].ansible_default_ipv4.netmask }} {
}
{% endif %}

subnet {{ pmc_pao_install_host_subnet }} netmask {{ pmc_pao_install_host_netmask }} {
  range {{ pmc_pao_install_dhcp_range_start }} {{ pmc_pao_install_dhcp_range_end }};
  option routers {{ pmc_pao_install_host_gw }};
  option domain-name-servers {{ pmc_pao_install_dns_ip }};
}
